{
    "name": "easy-project",
    "private": true,
    "version": "0.1.2",
    "type": "module",
    "scripts": {
        "security:patch": "node scripts/apply-dependency-security-patch.cjs && node scripts/apply-excel-stream-compat.cjs",
        "prelint": "npm run security:patch",
        "pretest": "npm run security:patch",
        "prebuild": "npm run security:patch",
        "predev": "npm run security:patch",
        "dev": "vite",
        "build": "node scripts/build-release-info.js --check && vite build",
        "lint": "eslint src e2e scripts *.config.js --max-warnings=0",
        "typecheck": "vue-tsc --noEmit",
        "preview": "vite preview",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:performance": "vitest run src/__tests__/gantt/criticalPath.test.js",
        "test:e2e": "node scripts/run-e2e.js",
        "test:e2e:production": "node scripts/run-e2e.js --production",
        "test:web": "node scripts/run-web-e2e.js",
        "release:check": "node scripts/check-release.js",
        "prerelease:check": "npm run security:patch"
    },
    "dependencies": {
        "@primeuix/themes": "^1.2.5",
        "@tauri-apps/api": "^2.12.1",
        "@tauri-apps/plugin-opener": "^2.7.0",
        "date-holidays": "^3.26.3",
        "exceljs": "^4.4.0",
        "html2canvas": "^1.4.1",
        "primeicons": "^7.0.0",
        "primevue": "^4.3.9",
        "vue": "^3.5.43",
        "vue-i18n": "11.4.16",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@tauri-apps/cli": "^2.12.1",
        "@types/node": "22.20.5",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/test-utils": "2.5.1",
        "eslint": "10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "5.5.7",
        "eslint-plugin-vue": "10.12.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.6.2",
        "typescript": "5.9.3",
        "vite": "6.4.5",
        "vitest": "4.1.12",
        "vue-tsc": "3.3.11"
    },
    "allowScripts": {
        "esbuild@0.25.10": true
    },
    "overrides": {
        "exceljs@^4.4.0": {
            "archiver": {
                ".": "7.0.1",
                "readdir-glob": {
                    ".": "3.0.0",
                    "minimatch": "11.0.4"
                }
            },
            "unzipper": "0.12.5"
        },
        "archiver-utils@5.0.2": {
            "glob": "14.0.2"
        },
        "eslint@10.14.0": {
            "minimatch": "11.0.1"
        },
        "@eslint/config-array@>=0.23.0": {
            "minimatch": "11.0.1"
        },
        "editorconfig@>=3.0.0": {
            "minimatch": "11.0.1"
        },
        "js-beautify@2.0.3": {
            "glob": "14.0.2"
        },
        "glob@>=9.0.0": {
            "minimatch": "11.0.1"
        },
        "uuid": "^11.1.1",
        "vitest": {
            "vite": "$vite"
        },
        "@vitest/mocker": {
            "vite": "$vite"
        }
    },
    "engines": {
        "node": "^22.22.2 || >=24.15.0"
    }
}
