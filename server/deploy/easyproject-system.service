[Unit]
Description=EasyProject private web server (dedicated account)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=easyproject
Group=easyproject
WorkingDirectory=/opt/easyproject/current
ExecStart=/opt/easyproject/current/bin/easyproject-server
Environment=EASYPROJECT_DATA_DIR=/var/lib/easyproject
Environment=EASYPROJECT_ASSETS_DIR=/opt/easyproject/current/web
Environment=EASYPROJECT_ORIGIN=https://home-host.tail2956dd.ts.net
Environment=EASYPROJECT_LISTEN=127.0.0.1:8080
Environment=EASYPROJECT_TRUSTED_PROXY=tailscale-loopback
Environment=EASYPROJECT_WORKSPACE_BUDGET_BYTES=536870912
Environment=EASYPROJECT_DATA_BUDGET_BYTES=8589934592
Environment=TZ=Asia/Shanghai
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/easyproject
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
