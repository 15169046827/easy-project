[Unit]
Description=EasyProject private headless server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/easyproject/current
ExecStart=%h/easyproject/current/bin/easyproject-server
Environment=EASYPROJECT_DATA_DIR=%h/easyproject/data
Environment=EASYPROJECT_ASSETS_DIR=%h/easyproject/current/web
Environment=EASYPROJECT_ORIGIN=https://home-host.tail2956dd.ts.net
Environment=EASYPROJECT_LISTEN=127.0.0.1:8080
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=default.target
