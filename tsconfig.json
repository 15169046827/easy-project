{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["vite/client", "node"],
        "paths": { "@/*": ["./src/*"] }
    },
    "include": [
        "src/**/*.js",
        "src/**/*.vue",
        "src/**/*.d.ts",
        "scripts/**/*.js",
        "e2e/**/*",
        "*.config.js"
    ]
}
